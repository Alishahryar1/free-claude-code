# Nebius Token Factory (OpenAI-compatible Chat Completions at api.tokenfactory.nebius.com/v1)
# NEBIUS_API_KEY=<your-token>


# Chutes (OpenAI-compatible Chat Completions at llm.chutes.ai/v1)
# CHUTES_API_KEY=<your-token>


# Featherless AI (OpenAI-compatible Chat Completions at api.featherless.ai/v1)
