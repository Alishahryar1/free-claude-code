# Per-provider proxy support: http and socks5, example: "http://username:password@host:port"
# OPENAI_PROXY=<http-or-socks-url>
# XAI_PROXY=<http-or-socks-url>
# QWENCLOUD_PROXY=<http-or-socks-url>
