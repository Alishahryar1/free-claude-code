+    def _wait_before_crash_restart(self, consecutive_failures: int) -> bool:
+        """Sleep before an automatic restart, reporting whether to proceed."""
+
+        if consecutive_failures <= 0:
+            return not self._is_stop_requested()
+        delay = min(
+            _CRASH_RESTART_MAX_DELAY_SECONDS,
+            _CRASH_RESTART_BASE_DELAY_SECONDS * 2 ** (consecutive_failures - 1),
+        )
+        # A stop requested during the wait must win over the pending restart.
+        return not self.stop_event.wait(delay)
